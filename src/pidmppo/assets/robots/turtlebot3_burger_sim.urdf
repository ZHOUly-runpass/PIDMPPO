<?xml version="1.0"?>
<robot name="turtlebot3_burger_sim">
  <material name="body_blue"><color rgba="0.08 0.32 0.58 1"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1"/></material>

  <link name="base_link">
    <inertial><origin xyz="0 0 0.065"/><mass value="1.0"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.007"/></inertial>
    <visual><origin xyz="0 0 0.065"/><geometry><cylinder radius="0.105" length="0.10"/></geometry><material name="body_blue"/></visual>
    <collision><origin xyz="0 0 0.065"/><geometry><cylinder radius="0.105" length="0.10"/></geometry></collision>
  </link>

  <link name="left_wheel_link">
    <inertial><mass value="0.03"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
    <visual><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.033" length="0.018"/></geometry><material name="wheel_black"/></visual>
    <collision><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.033" length="0.018"/></geometry></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/><origin xyz="0 0.080 0.033"/><axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <inertial><mass value="0.03"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
    <visual><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.033" length="0.018"/></geometry><material name="wheel_black"/></visual>
    <collision><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.033" length="0.018"/></geometry></collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/><origin xyz="0 -0.080 0.033"/><axis xyz="0 1 0"/>
  </joint>

  <link name="caster_link">
    <inertial><mass value="0.01"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    <visual><geometry><sphere radius="0.012"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><sphere radius="0.012"/></geometry></collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster_link"/><origin xyz="-0.085 0 0.012"/>
  </joint>
</robot>
